# TranscribeVid - production settings.
#
#   cp deploy/.env.example deploy/.env      (then edit deploy/.env; never commit it)
#   chmod 600 deploy/.env
#
# Format rules (the same file is read by Docker Compose and, for a non-Docker install, by systemd):
#   - one KEY=value per line, no quotes, no spaces around "=", comments only on their own line
#   - after any change:  docker compose up -d --force-recreate app caddy
#     (restarting the app ends every visitor's session - do it at a quiet time)

# =====================================================================================================================
# 1. Domain and HTTPS  (read by Caddy)
# =====================================================================================================================

# Contact address given to Let's Encrypt (certificate-expiry warnings). REQUIRED: use a real mailbox you read.
# Let's Encrypt refuses example.com addresses, so certificate issuance fails until this is changed.
ACME_EMAIL=you@example.com

# =====================================================================================================================
# 2. Public site
# =====================================================================================================================

# Public mode: visitors are isolated by a session cookie, files are deleted when a visitor goes idle, the limits
# below switch on. Must be exactly 1.
VT_PUBLIC=1

# The canonical address of the site (used for redirects, CORS and links).
VT_PUBLIC_URL=https://transcribevid.com

# Extra Host headers the app accepts besides VT_PUBLIC_URL's host, localhost and "app" (comma list, no spaces).
VT_ALLOWED_HOSTS=transcribevid.com,www.transcribevid.com

# Trust X-Forwarded-For / X-Forwarded-Proto from the reverse proxy. Needed so that rate limits see the visitor's
# real IP and not Caddy's, and so that the app knows the visitor used https. Keep it at 1 behind Caddy or nginx
# (at 0 the app thinks every request is plain http and redirects to https forever). Safe ONLY because the app
# port is not reachable from the internet: never publish port 8000 or bind it to a public address.
VT_TRUST_PROXY=1

# Public contact address shown on the Privacy / Terms pages (privacy requests, abuse reports). REQUIRED before
# launch: use a mailbox that really receives mail. Left empty, the site shows no contact address.
VT_CONTACT_EMAIL=

# Secret that protects the operator log API (/api/logs). Generate one:  openssl rand -hex 24
# Empty = the logs API is disabled on the public site (the safe default). Treat it like a password.
VT_ADMIN_TOKEN=

# =====================================================================================================================
# 3. Capacity and abuse limits
#    One transcription runs at a time (one worker); everything else waits in a queue shared by all visitors.
#    The values below suit an 8 vCPU / 16 GB server. App defaults in brackets where they differ.
# =====================================================================================================================

# Longest file a visitor may upload, in MiB. Caddy refuses bodies above ~600 MB (deploy/Caddyfile: request_body
# max_size); if you raise this above 550, raise that too. Also needs this much free scratch disk per queued file.
VT_MAX_UPLOAD_MB=500

# Longest audio/video a visitor may transcribe, in minutes (checked after upload). 0 = no limit.
# At large-v3-turbo speed (~1.5x realtime) 60 minutes of audio occupies the CPU for about 40 minutes.   [60]
VT_MAX_DURATION_MIN=60

# Models visitors may choose (comma list, no spaces). The first-use download of each model is 0.15 - 1.6 GB.
# Dropping large-v3-turbo is the quickest way to double throughput. Other ids: tiny, medium, large-v3, distil-large-v3.
VT_ALLOWED_MODELS=base,small,large-v3-turbo

# Jobs waiting + running, over all visitors. A full queue answers "busy, try again later". Wait time is roughly
# (queued audio minutes) / (model speed, see README). 0 = unlimited (not recommended).   [30]
# Together with VT_RATE_UPLOADS_PER_HOUR below this is what keeps one visitor from monopolising the server now
# that the number of transcriptions per visitor is unlimited.
VT_MAX_QUEUE=20

# Jobs one visitor session may hold at once (a session keeps its finished transcripts until it expires).
# 0 = UNLIMITED, which is what the site promises ("free, unlimited, no login"). The real protections are the
# queue cap above, the per-IP hourly limit below, the file size/duration limits and the session idle timeout.
# Set a number (for example 20) only if you must cap what one session can hold.   [0]
VT_MAX_JOBS_PER_SESSION=0

# Uploads one client IP may start per hour. Many people behind one office/campus NAT share an IP: raise it if
# real users complain. Keep it: with unlimited jobs per session it is the main brake on a single heavy user.   [30]
VT_RATE_UPLOADS_PER_HOUR=20

# Simultaneous visitor sessions (each = one cookie). Mostly memory bookkeeping; the queue is the real bottleneck.
VT_MAX_SESSIONS=200

# Minutes without a request after which a visitor's session and files are deleted.
VT_SESSION_IDLE_MINUTES=30

# Refuse new uploads when less than this many GB of disk are free (scratch volume). Raise it on small disks:
# the worst case is VT_MAX_QUEUE x VT_MAX_UPLOAD_MB of waiting uploads.
VT_MIN_FREE_GB=5

# =====================================================================================================================
# 4. "Videos transcribed" counter (the number in the website header)
#    ONE integer (how many uploaded files this site has transcribed) plus the time it last changed, in a small JSON
#    file. Nothing about visitors is stored with it - no IP, no session, no file name - so it is not personal data.
#    It is counted once per uploaded file when its transcription first finishes successfully (not for errors,
#    cancellations or "re-transcribe" runs). Served to the page by GET /api/stats.
# =====================================================================================================================

# auto = count only when VT_PUBLIC=1 (so a local "npm run dev" copy never counts and shows no number),
# 1 = always count, 0 = never count (the endpoint then answers {"transcribed": 0, "counting": false}).   [auto]
VT_COUNT_JOBS=auto

# Where the number is kept. With Docker this is already set by the image to /data/stats/stats.json, a persistent
# volume, so updates and restarts do not reset it: leave it commented out. Without Docker it defaults to
# stats.json inside VT_DATA_DIR (outside the "session" folder, which is wiped); set it only to put it elsewhere.
# VT_STATS_FILE=/var/lib/transcribevid/stats.json

# =====================================================================================================================
# 5. Performance
# =====================================================================================================================

# CPU threads for the Whisper model. 0 = library default (4). One job runs at a time, so give it most of the cores
# but leave some for audio decoding and the web server. Measured best on an 8-core machine: 4-6, more was slower.
# Starting points: 4 vCPU -> 3, 8 vCPU -> 6, 16 vCPU -> 6-8 (measure before going higher).
VT_CPU_THREADS=6

# 1 = load the default model (small) into memory at start if it is already downloaded, so the first visitor does
# not wait. Costs ~1 GB RAM permanently; set 0 on servers with 8 GB or less.
VT_WARMUP=1

# Number of recent log lines kept in memory for the operator log API (memory only, lost on restart).
VT_LOG_BUFFER=5000

# =====================================================================================================================
# 5b. Search engines (deploy/SEO.md)
# =====================================================================================================================

# Proof that you own the site, for Google Search Console / Bing Webmaster Tools, by their "HTML tag" method. Paste ONLY
# the code from the tag they show you: for <meta name="google-site-verification" content="AbC123..."> write
# VT_GOOGLE_SITE_VERIFICATION=AbC123...  (Bing's tag is <meta name="msvalidate.01" content="...">). Several codes
# (several people) are separated by commas. Leave empty when you verify by DNS record (recommended) or HTML file.
VT_GOOGLE_SITE_VERIFICATION=
VT_BING_SITE_VERIFICATION=

# IndexNow key (tells Bing, Yandex, Seznam and Naver at once that pages are new or changed): 8-128 letters, digits or
# dashes, e.g. made with:  openssl rand -hex 16   The app then serves it at https://transcribevid.com/<key>.txt and
# `node scripts/indexnow.mjs --key <key>` sends the sitemap's pages. Empty = off.
VT_INDEXNOW_KEY=

# gzip for pages, scripts, styles and JSON. Caddy / nginx keep the app's compressed answers as they are. [1]
VT_COMPRESS=1

# =====================================================================================================================
# 6. Fixed by the Docker image - do NOT set these when using Docker Compose
#    (listed because the backend reads them; a non-Docker install sets them, see deploy/README.md section 11)
# =====================================================================================================================
# VT_HOST=0.0.0.0
# VT_PORT=8000
# VT_DATA_DIR=/data
# VT_MODEL_DIR=/data/models
# VT_STATS_FILE=/data/stats/stats.json
# VT_STATIC_DIR=/app/frontend/dist/frontend/browser
